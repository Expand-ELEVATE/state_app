# Copy this file to .streamlit/secrets.toml and fill in YOUR state's values.
# NEVER commit the real secrets.toml — it is already in .gitignore.
# On Streamlit Community Cloud, paste these same keys into
# "Settings -> Secrets" for your deployed app instead of using a file.

SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"

# Use the ANON key here — never the service_role key. RLS scopes this
# state's admin login to its own state_code automatically once logged in.
SUPABASE_ANON_KEY = "your-anon-key"

# Fixed for this deployment — matches the `states.code` row for your state.
STATE_CODE = "MH"
